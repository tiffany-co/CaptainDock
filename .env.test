# --- TEST DATABASE CONFIGURATION ---
# This file is used by pytest to connect to a separate test database.

POSTGRES_SERVER=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_test
DB_PORT=5432

# --- REDIS CONFIGURATION ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- APPLICATION PORTS ---
BACKEND_PORT=8000

# --- JWT AUTHENTICATION ---
# Use a different secret key for tests for better isolation
SECRET_KEY=a-test-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_SECRET_KEY=another-test-secret-key
REFRESH_TOKEN_EXPIRE_MINUTES=10080